#!/usr/bin/env python3
"""When this pod's Claude login runs out, as a Prometheus metric on :9101.

A claude.ai login ends 30 days after `claude auth login`, however much the
pod is used (anthropics/claude-code#108586), and a pod that has lapsed serves
no sessions until someone logs it in again. Prometheus reads the date from
here and warns a few days ahead (clusters/lab/monitoring/agent-login-rules.yaml).

It reads the date from the credentials file and nothing else from it. It
never runs `claude`: a short-lived claude command can start a token refresh
and exit before saving it, which is one way to lose a login.
"""
import json
import os
from http.server import BaseHTTPRequestHandler, HTTPServer

CREDENTIALS = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude")), ".credentials.json")
PORT = 9101


def metrics() -> str:
    present, expires = 0, 0.0
    try:
        with open(CREDENTIALS) as f:
            oauth = json.load(f).get("claudeAiOauth") or {}
        if oauth.get("refreshToken"):
            present = 1
            expires = float(oauth.get("refreshTokenExpiresAt") or 0) / 1000
    except (OSError, ValueError, AttributeError):
        pass
    return (
        "# HELP claude_login_present 1 when the pod has a stored claude.ai login.\n"
        "# TYPE claude_login_present gauge\n"
        f"claude_login_present {present}\n"
        "# HELP claude_login_expires_timestamp_seconds When the stored login stops being renewable.\n"
        "# TYPE claude_login_expires_timestamp_seconds gauge\n"
        f"claude_login_expires_timestamp_seconds {expires:.0f}\n"
    )


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path != "/metrics":
            self.send_error(404)
            return
        body = metrics().encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; version=0.0.4")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):  # the pod's log is for the server, not for scrapes
        pass


if __name__ == "__main__":
    HTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
