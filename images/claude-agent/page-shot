#!/usr/bin/env python3
"""A picture of a web page, the whole page by default.

  page-shot URL OUT.png              the page top to bottom, one tall image
  page-shot URL OUT.png --tiles      the same, cut into screen-high pieces
                                     OUT-01.png, OUT-02.png, ... - a tall
                                     image is shrunk when it is looked at,
                                     and the pieces stay readable
  page-shot URL OUT.png --viewport   only the first screen
  --width N                          page width in pixels (default 1280)
  --wait MS                          extra wait after loading, for pages
                                     that draw themselves late

The browser is the image's Chromium, driven by Playwright. No sandbox flag:
the pod has no capabilities to build one with, and the pod is the sandbox.
"""
import argparse
import sys
from pathlib import Path

from playwright.sync_api import sync_playwright

TILE = 1600


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("url")
    ap.add_argument("out")
    ap.add_argument("--tiles", action="store_true")
    ap.add_argument("--viewport", action="store_true")
    ap.add_argument("--width", type=int, default=1280)
    ap.add_argument("--wait", type=int, default=0)
    a = ap.parse_args()

    out = Path(a.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as p:
        browser = p.chromium.launch(executable_path="/usr/bin/chromium", args=["--no-sandbox"])
        page = browser.new_page(viewport={"width": a.width, "height": 800})
        try:
            page.goto(a.url, wait_until="networkidle", timeout=45000)
        except Exception as e:  # a page that never goes quiet is still worth a picture
            print(f"note: {type(e).__name__} while loading, taking the picture anyway", file=sys.stderr)
        if a.wait:
            page.wait_for_timeout(a.wait)
        page.screenshot(path=str(out), full_page=not a.viewport)
        title = page.title()
        browser.close()

    from PIL import Image

    Image.MAX_IMAGE_PIXELS = None
    im = Image.open(out)
    print(f"{out}  {im.width}x{im.height}  {title}")
    if a.tiles and im.height > TILE:
        n = 0
        for top in range(0, im.height, TILE):
            n += 1
            piece = out.with_name(f"{out.stem}-{n:02d}{out.suffix}")
            im.crop((0, top, im.width, min(top + TILE, im.height))).save(piece)
            print(piece)
    return 0


if __name__ == "__main__":
    sys.exit(main())
